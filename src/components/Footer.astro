---
import { getCollection } from "astro:content";
import Arches from "./Arches.astro";
import Logo from "./Logo.astro";
import { isPlaceholder, isWebUrl, phoneUrl, whatsappUrl } from "../lib/contact";
import { getSiteData } from "../lib/site";

const site = await getSiteData();

const allenamenti = (await getCollection("allenamenti")).sort(
	(a, b) => a.data.ordine - b.data.ordine,
);
const sponsor = (await getCollection("sponsor")).sort(
	(a, b) => a.data.ordine - b.data.ordine,
);

const telefono = phoneUrl(site.telefono);
const whatsapp = whatsappUrl(site.whatsapp);
const mappe = isWebUrl(site.google_maps) ? site.google_maps : undefined;

const social = [
	{ label: "Facebook", url: site.facebook },
	{ label: "Instagram", url: site.instagram },
	{ label: "YouTube", url: site.youtube },
];

const primoAllenamento = allenamenti[0];
const testoAllenamenti = primoAllenamento
	? `${primoAllenamento.data.giorno} · ${primoAllenamento.data.orario}`
	: "[DA COMPILARE]";

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<Arches class="site-footer__arches" />

	<div class="container">
		<div class="footer-grid">
			<div class="footer-brand">
				<Logo />
				<p>{site.testo_footer}</p>
				<div class="footer-social" role="group" aria-label="Social">
					{
						social.map(({ label, url }) => (
							<span>
								{isWebUrl(url) ? (
									<a href={url} target="_blank" rel="noreferrer">{label}</a>
								) : (
									`${label} · [DA COMPILARE]`
								)}
							</span>
						))
					}
				</div>
			</div>

			<div>
				<h2 class="footer-title">Contatti</h2>
				<ul class="footer-list">
					<li>
						Email:{" "}
						{isPlaceholder(site.email) ? (
							site.email
						) : (
							<a href={`mailto:${site.email}`}>{site.email}</a>
						)}
					</li>
					<li>
						Telefono:{" "}
						{telefono ? (
							<a href={telefono}>{site.telefono}</a>
						) : (
							site.telefono
						)}
					</li>
					<li>
						WhatsApp:{" "}
						{whatsapp ? (
							<a href={whatsapp} target="_blank" rel="noreferrer">
								{site.whatsapp}
							</a>
						) : (
							site.whatsapp
						)}
					</li>
					<li>
						Sede:{" "}
						{mappe ? (
							<a href={mappe} target="_blank" rel="noreferrer">
								{site.sede}
							</a>
						) : (
							site.sede
						)}
					</li>
					<li>Allenamenti: {testoAllenamenti}</li>
				</ul>
			</div>

			<div>
				<h2 class="footer-title">Link utili</h2>
				<ul class="footer-list">
					<li><a href="/chi-siamo">Chi siamo</a></li>
					<li><a href="/calendario">Calendario gare</a></li>
					<li><a href="/news">News</a></li>
					<li><a href="/stralucera">Stralucera</a></li>
					<li><a href="/unisciti-a-noi">Unisciti a noi</a></li>
					<li><a href="/contatti">Contatti</a></li>
					<li><a href="/privacy">Privacy</a></li>
				</ul>
			</div>
		</div>

		<div class="footer-sponsors">
			<strong>Sponsor</strong>
			{sponsor.map((voce) => <span>{voce.data.nome}</span>)}
		</div>

		<div class="footer-bottom">
			<p>© {year} ASD I Saraceni di Lucera</p>
			<p class="footer-fidal">ASD affiliata FIDAL · Codice {site.codice_fidal}</p>
			<p>Questo sito non usa cookie di profilazione.</p>
		</div>
	</div>
</footer>
