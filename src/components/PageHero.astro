---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Arches from "./Arches.astro";

interface Props {
	eyebrow: string;
	title: string;
	lead?: string;
	image?: ImageMetadata;
	imageAlt?: string;
}

const { eyebrow, title, lead, image, imageAlt = "" } = Astro.props;
---

<section class="page-hero">
	<Arches class="page-hero__arches" />

	<div class:list={["container", "page-hero__grid", { "page-hero__grid--media": image }]}>
		<div class="page-hero__copy">
			<p class="eyebrow eyebrow--lime">{eyebrow}</p>
			<h1>{title}</h1>
			{lead && <p class="page-hero__lead">{lead}</p>}
			<slot />
		</div>

		{
			image && (
				<div class="page-hero__media">
					<Image
						src={image}
						alt={imageAlt}
						widths={[480, 800, 1200]}
						sizes="(min-width: 900px) 42vw, 100vw"
						format="webp"
						loading="eager"
						decoding="async"
					/>
				</div>
			)
		}
	</div>
</section>
